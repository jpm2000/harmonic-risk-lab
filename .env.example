# ── Harmonic Aristotle ────────────────────────────────────────────────────────
# Get from: https://aristotle.harmonic.fun → Dashboard → API Keys
ARISTOTLE_API_KEY=your_aristotle_api_key_here

# ── Gemini (two options — use ONE) ───────────────────────────────────────────

# Option A: Personal API key (aistudio.google.com/apikey)
# Works unless your org blocks API keys.
GEMINI_API_KEY=your_gemini_api_key_here

# Option B: Application Default Credentials / ADC (enterprise / org accounts)
# Use when your org policy blocks API keys (Vertex AI / Agent Platform).
# Setup: run in terminal →  bash <(curl -sSL https://storage.googleapis.com/cloud-samples-data/adc/setup_adc.sh)
# Then fill in your Google Cloud project ID below:
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
